# =============================================================================
# Monkey Radio — Environment Configuration
# Copy to .env and fill in values. See DEPLOY.md for production on Render.
# =============================================================================


# --- Paths -------------------------------------------------------------------
# Local dev defaults. Render overrides these in render.yaml (/app/data/...).

DATABASE_PATH=./data/monkey-radio.db
LIBRARY_PATH=./data/library
DJ_PATH=./data/dj


# --- CDN (Cloudflare R2) -----------------------------------------------------
# Public URL for track MP3s. Required for production (library lives on R2).
# DJ segments always stream from the server.

LIBRARY_CDN_URL=

# R2 upload credentials (local CLI only — npm run library:sync-cdn)
R2_BUCKET=
R2_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# --- AI: DJ brain (required for production) ----------------------------------
# Without keys, mock LLM + TTS are used automatically.

OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=xUwWtrwxKYQAFNPrH25f
ELEVENLABS_MODEL=eleven_turbo_v2_5


# --- Broadcast ---------------------------------------------------------------

DEFAULT_GENRE=lofi
MIN_LIBRARY_PER_GENRE=10
AVOID_REPLAY_LIMIT=50
CROSSFADE_SEC=5
MIN_TRACKS_BEFORE_DJ=1
DJ_MIN_INTERVAL_SEC=120
DJ_PREP_LEAD_SEC=45


# --- YouTube Live (required for 24/7 stream) ---------------------------------
# Setup: npm run youtube:live-auth && npm run youtube:live-create

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_BROADCAST_ID=
YOUTUBE_VIDEO_ID=
YOUTUBE_RTMP_URL=
YOUTUBE_STREAM_KEY=
YOUTUBE_API_KEY=
CHAT_PROVIDER=youtube
# YouTube Data API default quota is 10,000 units/day (resets midnight Pacific).
# Chat poll: ~5 units/call. Track chat posts: 200 units each. Live description updates: ~51 units each.
CHAT_POLL_INTERVAL_MS=15000
CHAT_WINDOW_MS=300000
# Set false to save quota if you hit quotaExceeded errors (default true)
YOUTUBE_ANNOUNCE_TRACKS_IN_CHAT=true
YOUTUBE_UPDATE_LIVE_DESCRIPTION=true
# Comma-separated display names the DJ should ignore (channel owner is always ignored on YouTube)
CHAT_IGNORE_USERNAMES=


# --- Dashboard ---------------------------------------------------------------

DASHBOARD_PORT=5400
DASHBOARD_URL=http://localhost:5400
ADMIN_API_KEY=
BROADCAST_STALE_SEC=300


# --- Stream encoder (Docker / Render — defaults usually fine) ----------------

STREAM_DISPLAY=:99
STREAM_PULSE_MONITOR=stream_sink.monitor
STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_FRAME_RATE=24
STREAM_VIDEO_BITRATE=2500k
STREAM_AUDIO_BITRATE=128k
STREAM_VIDEO_PRESET=ultrafast
STREAM_VIDEO_THREADS=2


# --- Local dev: music generation (not needed on Render) ----------------------
# Run on your machine, sync library to R2, then deploy.

STAGING_PATH=./data/staging/songs
MUSIC_LENGTH_MS=120000
MUSIC_MODEL_ID=music_v2
TRACKS_PER_GENRE=20
MAX_CONCURRENT_GENERATIONS=2
GENERATION_POLL_INTERVAL_MS=10000
GENERATION_TIMEOUT_MS=300000
MAX_RETRIES=3
PREFER_INSTRUMENTAL=true


# --- Local dev: YouTube VOD upload (optional) --------------------------------

VIDEO_OUTPUT_PATH=./data/videos
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8765/oauth/callback
YOUTUBE_VIDEO_PRIVACY=unlisted


# --- Local dev: legacy Suno generation (optional) ----------------------------

# SUNO_PROVIDER=mock
# SUNO_API_BASE_URL=http://localhost:3001
# SUNO_COOKIE=
# SUNO_COOKIE_FILE=./data/suno-cookie.txt
# SUNO_BROWSER_STATE=./data/suno-browser-state.json
